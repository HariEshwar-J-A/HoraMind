# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Secrets
.env
.env.local
.env.*.local
openclaw.json

# Legacy file-based state from the Telegram agent. Replaced by Postgres;
# these paths must never be committed if an old checkout still has them.
/users/
rate_limits.json

# Local infrastructure state
infra/docker/backups/
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
*.tfvars
!*.tfvars.example

# Mobile
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
*.keystore
*.p8
*.p12
*.mobileprovision

# Test and tooling output
coverage/
.vitest/
*.log

# AI
CLAUDE.md
# Local Claude state stays private; the committed run skill does not — it is
# shared tooling, and a driver nobody else can check out is not much of a
# driver. A bare `!.claude/skills/` would not work: git does not descend into
# an excluded directory, so the parent has to be `.claude/*`.
.claude/*
!.claude/skills/

# Cloudflare Tunnel — instance-specific, contains a UUID and credentials
infra/docker/cloudflared/config.yml
infra/docker/cloudflared/creds.json

# Built client, mounted at runtime
infra/docker/web-placeholder/*
!infra/docker/web-placeholder/.gitkeep

# Terraform
infra/terraform/.terraform/
infra/terraform/terraform.tfvars
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/.terraform.lock.hcl
