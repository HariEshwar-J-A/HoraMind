# HoraMind configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# Every value marked REQUIRED has no default: the process refuses to start
# without it, which is deliberate — a server that boots with a placeholder
# secret looks healthy while being wrong.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# Set to true only when running behind Caddy, an ingress, or a load balancer.
# If it is false behind a proxy, every client IP reads as the proxy's and all
# users share one rate-limit bucket.
TRUST_PROXY=false

# Comma-separated origins in production; "*" only in development.
CORS_ORIGIN=*

PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
POSTGRES_USER=horamind
POSTGRES_PASSWORD=change-me-before-anything-real
POSTGRES_DB=horamind
DATABASE_URL=postgres://horamind:change-me-before-anything-real@localhost:5432/horamind
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Auth — REQUIRED
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=horamind
JWT_AUDIENCE=horamind-app

# OAuth client ids. Used to verify the `aud` claim on incoming ID tokens, so a
# token minted for a different app cannot be replayed against this one.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

# Sign in with Apple. Required by App Store Guideline 4.8 once Google login is
# offered — the bundle id for native, the service id for web.
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=

# ---------------------------------------------------------------------------
# Retrieval (JyotishBase / ChromaDB)
# ---------------------------------------------------------------------------
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=santhanam_source_of_truth

# Host path to the ingested corpus, mounted into the chroma container.
JYOTISHBASE_CHROMA_PATH=../../../JyotishBase/chroma_data

# ---------------------------------------------------------------------------
# AI (OpenRouter)
# ---------------------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The :free Llama slug was retired. Gemini Flash is single-provider, which
# matters: a multi-provider model will randomly hit DeepInfra and return a
# hollow 200 (null content, no usage, finish_reason null).
OPENROUTER_MODEL_FREE=google/gemini-2.5-flash
OPENROUTER_MODEL_PAID=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Web Push (optional)
# ---------------------------------------------------------------------------
# Generate with:  npx web-push generate-vapid-keys
# Leave blank to disable push; in-app notifications still work.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Ephemeris
# ---------------------------------------------------------------------------
# Optional. node-jhora resolves de440s.bsp from @node-jhora/ephe when unset.
# NODE_JHORA_EPHE_PATH=/app/ephe/de440s.bsp

# ---------------------------------------------------------------------------
# Docker only
# ---------------------------------------------------------------------------
API_PORT=8080

# Built PWA, bind-mounted into Caddy. Leave as the placeholder until Epic 7.
WEB_DIST_PATH=./web-placeholder

# ---------------------------------------------------------------------------
# Cloudflare Tunnel  (profile: tunnel)
# ---------------------------------------------------------------------------
# This machine already runs a tunnel for another application. HoraMind gets its
# OWN tunnel — separate UUID, separate credentials, separate config — so the two
# cannot interfere. The UUID and hostname are written as literals into
# infra/docker/cloudflared/config.yml, because cloudflared does not expand
# environment variables in that file.
#
# Before first use:
#   ./infra/scripts/tunnel-preflight.sh horamind astrology.harieshwar.dev
#
# Then:
#   docker compose -f infra/docker/docker-compose.yml --profile tunnel up -d
#
# With the tunnel in front, PUBLIC_BASE_URL and CORS_ORIGIN should name the
# public hostname, and TRUST_PROXY must be true or every client IP reads as
# cloudflared's.
#   PUBLIC_BASE_URL=https://astrology.harieshwar.dev
#   CORS_ORIGIN=https://astrology.harieshwar.dev
#   TRUST_PROXY=true
